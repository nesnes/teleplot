{
  "name": "teleplot",
  "version": "0.1.0",
  "description": "Teleplot server: relays telemetry received as UDP packets to the Teleplot web page through a WebSocket, and serves that page",
  "main": "main.js",
  "bin": "main.js",
  "scripts": {
    "test": "node tests/run.js",
    "start": "node main.js",
    "make": "npx --yes @yao-pkg/pkg@6.23.0 . --no-bytecode --public-packages \"*\" --public"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.17.1",
    "express-ws": "^5.0.2"
  },
  "pkg": {
    "scripts": "main.js",
    "assets": "www/**",
    "targets": ["node22-linux-x64", "node22-linux-arm64", "node22-macos-x64", "node22-macos-arm64", "node22-win-x64"],
    "outputPath": "build"
  }
}
