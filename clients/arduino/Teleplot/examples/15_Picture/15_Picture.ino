  0x24, 0x49, 0x44, 0x41, 0x54, 0x78, 0xDA, 0x63, 0x30, 0xF1, 0x8C, 0x83,
  0x23, 0xBD, 0x33, 0x85, 0x70, 0x84, 0x4B, 0x9C, 0x61, 0x10, 0x6A, 0x20,
  0x46, 0x11, 0xB2, 0xF8, 0x60, 0xD4, 0x30, 0x1A, 0x0F, 0x83, 0x42, 0x03,
