// 14. A camera: its pictures, its lens (intrinsics, distortion) and where it is. The page draws the scene over its pictures as the
// lens sees it (a box in the scene), and drawings made in the pixels of the picture (a detection).
// Here the picture is the small PNG of 13_Picture (16 x 16 pixels); an ESP32-CAM gives JPEG frames of its own.
#include <Teleplot.h>

Teleplot tp(Serial);
const uint8_t TILE[] = {
  0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0x00, 0x00, 0x00, 0x0D,
  0x49, 0x48, 0x44, 0x52, 0x00, 0x00, 0x00, 0x10, 0x00, 0x00, 0x00, 0x10,
  0x08, 0x02, 0x00, 0x00, 0x00, 0x90, 0x91, 0x68, 0x36, 0x00, 0x00, 0x00,
  0x24, 0x49, 0x44, 0x41, 0x54, 0x78, 0xDA, 0x63, 0x30, 0xF1, 0x8C, 0x83,
  0x23, 0xBD, 0x33, 0x85, 0x70, 0x84, 0x4B, 0x9C, 0x61, 0x10, 0x6A, 0x20,
  0x46, 0x11, 0xB2, 0xF8, 0x60, 0xD4, 0x30, 0x1A, 0x0F, 0x83, 0x42, 0x03,
  0x00, 0x7E, 0xA3, 0x23, 0x10, 0xC3, 0x15, 0x3F, 0xBD, 0x00, 0x00, 0x00,
  0x00, 0x49, 0x45, 0x4E, 0x44, 0xAE, 0x42, 0x60, 0x82,
};

void setup() {
  Serial.begin(115200);
  tp.telemetry("camera").intrinsics(16, 16, 14, 14, 8, 8).distortion(-0.1, 0.01, 0, 0, 0);
  tp.telemetry("camera").position(-2, 0, 0.5);  // looking along its x axis: toward the box
  tp.telemetry("box").shape(Teleplot::Cube).size(0.5).position(0, 0, 0.25).color("orange");
  tp.telemetry("detection").pixelsOf("camera").shape(Teleplot::Rect).color("red");
}

void loop() {
  tp.telemetry("camera").image(Teleplot::Png, TILE, sizeof(TILE));
  tp.telemetry("detection").position(8 + 3 * sin(millis() / 1000.0), 8).size(4, 3);  // a box in pixels (u to the right, v down)
  delay(200);
}
